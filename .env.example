# ERP Frontend — Environment Variables
# Copy file này thành .env rồi điền giá trị thực tế
# Lưu ý: .env KHÔNG commit lên git (đã có trong .gitignore)

# ── API Backend ──────────────────────────────────────────────
# URL của backend NestJS (KHÔNG có /api ở cuối)
VITE_API_URL=https://erp-fmcg-backend.onrender.com

# ── Map style ───────────────────────────────────────────────
# Có 3 lựa chọn:
# 1) Để trống VITE_MAP_STYLE_URL → dùng OpenFreeMap Liberty (mặc định, free, Vietnam OK)
# 2) Set VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty  (hoặc positron/bright)
# 3) VITE_USE_VIETMAP_TILES=true → dùng Vietmap tiles qua backend proxy (chỉ khi proxy works)
VITE_USE_VIETMAP_TILES=false
VITE_MAP_STYLE_URL=

# ── Vietmap (chỉ cần cho geocoding API backend ↔ frontend, không dùng cho tiles) ──
VITE_VIETMAP_API_KEY=your_vietmap_api_key_here