# ERP Frontend — Environment Variables
# Copy file này thành .env rồi điền giá trị thực tế
# Lưu ý: .env KHÔNG commit lên git (đã có trong .gitignore)

# ── API Backend ──────────────────────────────────────────────
# URL của backend NestJS (KHÔNG có /api ở cuối)
VITE_API_URL=https://erp-fmcg-backend.onrender.com

# ── Vietmap (bản đồ) ────────────────────────────────────────
# API key Vietmap — dùng cho tiles + geocoding.
# Set trên Vercel dashboard: Settings → Environment Variables
# Lưu ý: style URL dùng `apikey=` (không có dấu gạch ngang).
VITE_VIETMAP_API_KEY=your_vietmap_api_key_here
VITE_VIETMAP_STYLE=https://maps.vietmap.vn/maps/styles/tm/style.json?apikey=your_vietmap_api_key_here