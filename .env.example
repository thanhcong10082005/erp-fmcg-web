# ERP Frontend — Environment Variables
# Copy file này thành .env rồi điền giá trị thực tế
# Lưu ý: .env KHÔNG commit lên git (đã có trong .gitignore)

# ── API Backend ──────────────────────────────────────────────
# URL của backend NestJS (KHÔNG có /api ở cuối)
VITE_API_URL=https://erp-fmcg-backend.onrender.com

# ── Map style ───────────────────────────────────────────────
# Có 3 lựa chọn:
# 1) Để trống VITE_MAP_STYLE_URL → dùng OpenFreeMap Liberty (mặc định, free, Vietnam OK)
# 2) Set VITE_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/liberty  (hoặc positron/bright)
# 3) VITE_USE_VIETMAP_TILES=true → dùng Vietmap tiles (key=1f7fe529...)
#    a. Nếu đã set VITE_VIETMAP_STYLE → dùng trực tiếp CDN Vietmap (browser IP OK, CORS mở)
#    b. Không set style → fallback qua backend proxy /api/vietmap/maps/styles/tm/style.json
VITE_USE_VIETMAP_TILES=false
VITE_MAP_STYLE_URL=

# ── Vietmap API keys ────────────────────────────────────────
# Geocode key (296e67...) — search/route, dùng qua backend /api/vietmap/search
# và backend GeocodingService để forward geocode address → lat/lng
VITE_VIETMAP_API_KEY=your_vietmap_search_api_key_here

# Tile key (1f7fe529...) — chỉ dùng cho tiles/styles/sprites/fonts.
# Browser tự gọi thẳng maps.vietmap.vn (CORS *, IP browser OK).
# KHÔNG hardcode key thật trong file này — set trên Vercel/Render Dashboard.
VITE_VIETMAP_TILE_API_KEY=your_vietmap_tile_api_key_here

# Style URL (optional). Nếu set, dùng trực tiếp — thường để trống để dùng mặc định
# Vietmap "tm" style. Ví dụ: https://maps.vietmap.vn/maps/styles/tm/style.json
VITE_VIETMAP_STYLE=